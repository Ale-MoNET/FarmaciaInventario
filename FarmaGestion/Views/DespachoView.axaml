<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FarmaGestion.ViewModels"
             x:Class="FarmaGestion.Views.DespachoView"
             x:DataType="vm:DespachoViewModel">
    
    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="15" Margin="0,0,0,10">
            <TextBox x:Name="TxtCodigoBusqueda"
                     Text="{Binding CodigoBusqueda}" 
                     PlaceholderText="Escanea o escribe el código y presiona Enter..." 
                     Width="400" FontSize="18" Padding="10">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AgregarCarritoCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
            
            <Button Content="Agregar" 
                    Command="{Binding AgregarCarritoCommand}"
                    Background="#007bff" Foreground="White" 
                    FontWeight="Bold" Padding="20,10"/>
        </StackPanel>

        <TextBlock Grid.Row="1" 
                   Text="{Binding MensajeAlerta}" 
                   Foreground="#dc3545" FontWeight="Bold" FontSize="16"
                   Margin="0,0,0,15" TextWrapping="Wrap"/>

        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding Carritos}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  GridLinesVisibility="All"
                  BorderThickness="1" BorderBrush="LightGray">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Medicamento.CodigoBarras}" Width="150"/>
                <DataGridTextColumn Header="Producto" Binding="{Binding Medicamento.Nombre}" Width="*"/>
                <DataGridTextColumn Header="Precio Unit." Binding="{Binding Medicamento.Precio, StringFormat='{}{0:C}'}" Width="120"/>
                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad}" Width="100"/>
                <DataGridTextColumn Header="Su btotal" Binding="{Binding Subtotal, StringFormat='{}{0:C}'}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" ColumnDefinitions="*, Auto" Margin="0,20,0,0">
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" VerticalAlignment="Center">
                <TextBlock Text="Total a Pagar:" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding TotalDespacho, StringFormat='{}{0:C}'}" FontSize="28" FontWeight="Bold" Foreground="#d9534f" VerticalAlignment="Center"/>
                
                <Button Content="Confirmar Despacho" 
                        Command="{Binding ConfirmarDespachoCommand}"
                        Background="#28a745" Foreground="White" 
                        FontSize="18" FontWeight="Bold" Padding="25,15" Margin="20,0,0,0"/>
            </StackPanel>
        </Grid>
        
    </Grid>
</UserControl>