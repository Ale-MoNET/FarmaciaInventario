<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FarmaGestion.ViewModels"
        xmlns:conv="clr-namespace:FarmaGestion.Views.Converters"
        x:Class="FarmaGestion.Views.ComprobanteWindow"
        x:DataType="vm:ComprobanteViewModel"
        Title="Despacho confirmado"
        Icon="/Assets/farma-icon.png"
        Width="640" SizeToContent="Height" MaxHeight="800"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0A0D13">

    <Window.Resources>
        <conv:StringToBrushConverter x:Key="StrBrush"/>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontFamily" Value="Consolas, 'Courier New', monospace"/>
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="Foreground" Value="#8B96A4"/>
        </Style>
        <Style Selector="Path.svg">
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style Selector="Polyline.svg">
            <Setter Property="StrokeThickness" Value="2.2"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="Foreground" Value="#EEF2F6"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Padding" Value="18,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
        </Style>
        <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#34E0A1"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" Margin="26">

        <!-- Encabezado -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,18">
            <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                    Background="#1F34E0A1" Margin="0,0,14,0" VerticalAlignment="Center">
                <Viewbox Width="22" Height="22">
                    <Canvas Width="24" Height="24">
                        <Polyline Classes="svg" Stroke="#34E0A1" Points="20,6 9,17 4,12"/>
                    </Canvas>
                </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                <TextBlock Text="{Binding TituloTexto}" FontSize="19" FontWeight="Bold" Foreground="#EEF2F6"/>
                <TextBlock Text="{Binding SubtituloTexto}"
                           FontSize="12.5" Foreground="#8B96A4" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="COMPROBANTE" Classes="eyebrow" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding NumeroTexto}" FontSize="20" FontWeight="Bold"
                           Foreground="#34E0A1" HorizontalAlignment="Right"
                           FontFamily="Consolas, 'Courier New', monospace"/>
            </StackPanel>
        </Grid>

        <!-- Datos generales -->
        <Border Grid.Row="1" CornerRadius="12" BorderBrush="#12FFFFFF" BorderThickness="1"
                Background="#06FFFFFF" Padding="18,14" Margin="0,0,0,14">
            <Grid ColumnDefinitions="*,*,*">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="FECHA Y HORA" Classes="eyebrow"/>
                    <TextBlock Text="{Binding FechaTexto}" FontSize="13" Foreground="#EEF2F6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="ATENDIÓ" Classes="eyebrow"/>
                    <TextBlock Text="{Binding AtendioTexto}" FontSize="13" Foreground="#EEF2F6"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="RESUMEN" Classes="eyebrow"/>
                    <TextBlock Text="{Binding ResumenTexto}" FontSize="13" Foreground="#EEF2F6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Aviso: despacho deshecho -->
        <Border Grid.Row="2" IsVisible="{Binding Anulado}" CornerRadius="12" BorderBrush="#40FF6B6B"
                BorderThickness="1" Background="#1AFF6B6B" Padding="16,12" Margin="0,0,0,14">
            <Grid ColumnDefinitions="Auto,12,*">
                <Border Grid.Column="0" CornerRadius="999" Padding="10,3" Background="#33FF6B6B" VerticalAlignment="Center">
                    <TextBlock Text="ANULADO" FontSize="11" FontWeight="Bold" Foreground="#FF8B8B"
                               FontFamily="Consolas, 'Courier New', monospace"/>
                </Border>
                <TextBlock Grid.Column="2" Text="{Binding AnuladoTexto}" FontSize="12.5" Foreground="#FFB3B3"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Detalle -->
        <Border Grid.Row="3" CornerRadius="12" BorderBrush="#12FFFFFF" BorderThickness="1"
                Background="#04FFFFFF" ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto">
                <Grid Grid.Row="0" ColumnDefinitions="110,*,54,92,100" Background="#08FFFFFF">
                    <TextBlock Grid.Column="0" Text="CÓDIGO" Classes="eyebrow" Margin="16,11"/>
                    <TextBlock Grid.Column="1" Text="PRODUCTO" Classes="eyebrow" Margin="0,11"/>
                    <TextBlock Grid.Column="2" Text="CANT." Classes="eyebrow" Margin="0,11" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="3" Text="P. UNIT." Classes="eyebrow" Margin="0,11" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="SUBTOTAL" Classes="eyebrow" Margin="0,11,16,11" HorizontalAlignment="Right"/>
                </Grid>

                <ScrollViewer Grid.Row="1" MaxHeight="240" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Lineas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LineaComprobanteItem">
                                <Border BorderBrush="#0CFFFFFF" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="110,*,54,92,100" MinHeight="44">
                                        <TextBlock Grid.Column="0" Text="{Binding Codigo}" Margin="16,0"
                                                   FontFamily="Consolas, monospace" FontSize="12" Foreground="#8B96A4"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="0,6">
                                            <TextBlock Text="{Binding Nombre}" FontSize="13.5"
                                                       Foreground="#EEF2F6" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding LoteTexto}" IsVisible="{Binding TieneLote}"
                                                       FontFamily="Consolas, monospace" FontSize="11" Foreground="#8B96A4"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding CantidadTexto}" HorizontalAlignment="Right"
                                                   FontFamily="Consolas, monospace" FontSize="13" Foreground="#C2CCD6"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding PrecioTexto}" HorizontalAlignment="Right"
                                                   FontFamily="Consolas, monospace" FontSize="12.5" Foreground="#8B96A4"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding SubtotalTexto}" HorizontalAlignment="Right"
                                                   Margin="0,0,16,0" FontFamily="Consolas, monospace" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="#5CE8B4" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Total -->
        <Border Grid.Row="4" Margin="0,14,0,0" CornerRadius="12" BorderBrush="#2634E0A1"
                BorderThickness="1" Background="#0D34E0A1" Padding="18,14">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="TOTAL DEL DESPACHO" Classes="eyebrow" FontSize="11"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding TotalTexto}" FontSize="26" FontWeight="Bold"
                           Foreground="#EEF2F6" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Acciones -->
        <Grid Grid.Row="5" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,18,0,0">
            <Button Grid.Column="0" x:Name="BtnCerrar" Content="Cerrar" Click="Cerrar_Click"
                    Background="Transparent" Foreground="#8B96A4" BorderThickness="0"
                    FontWeight="SemiBold" FontSize="13.5" Padding="4,12"/>

            <Button Grid.Column="1" x:Name="BtnDeshacer" Click="Deshacer_Click"
                    IsVisible="{Binding PuedeDeshacer}" Margin="10,0,0,0"
                    Background="Transparent" Foreground="#FF8B8B"
                    BorderBrush="#2EFF6B6B" BorderThickness="1" CornerRadius="11"
                    FontWeight="SemiBold" FontSize="13" Padding="14,11"
                    ToolTip.Tip="Devuelve las unidades al inventario y anula esta venta">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="↺" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock Text="Deshacer despacho" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="3" x:Name="BtnImprimir" Classes="ghost" Click="Imprimir_Click"
                    Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Polyline Classes="svg" Stroke="#EEF2F6" Points="6,9 6,2 18,2 18,9"/>
                            <Path Classes="svg" Stroke="#EEF2F6"
                                  Data="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                            <Path Classes="svg" Stroke="#EEF2F6" Data="M6 14h12v8H6z"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Imprimir" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button Grid.Column="4" x:Name="BtnDescargar" Click="Descargar_Click"
                    Background="#34E0A1" Foreground="#04160E" CornerRadius="11" Padding="20,12"
                    FontWeight="SemiBold" FontSize="13.5">
                <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <Viewbox Width="16" Height="16">
                        <Canvas Width="24" Height="24">
                            <Path Classes="svg" Stroke="#04160E" Data="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                            <Polyline Classes="svg" Stroke="#04160E" Points="7,10 12,15 17,10"/>
                            <Path Classes="svg" Stroke="#04160E" Data="M12 15V3"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Descargar PDF" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Mensaje de resultado -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="7" Margin="0,12,0,0"
                    IsVisible="{Binding HayEstado}">
            <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                     Fill="{Binding EstadoColor, Converter={StaticResource StrBrush}}"/>
            <TextBlock Text="{Binding Estado}" FontSize="12.5" TextWrapping="Wrap"
                       Foreground="{Binding EstadoColor, Converter={StaticResource StrBrush}}"/>
        </StackPanel>

    </Grid>
</Window>
