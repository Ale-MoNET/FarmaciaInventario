<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FarmaGestion.ViewModels"
             x:Class="FarmaGestion.Views.ReportesView"
             x:DataType="vm:ReportesViewModel"
             Background="#0A0D13">

    <UserControl.Styles>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontFamily" Value="Consolas, 'Courier New', monospace"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#8B96A4"/>
        </Style>
        <Style Selector="Path.svg">
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style Selector="Polyline.svg">
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="#0A0D13">
        <StackPanel Margin="22" Spacing="16">

            <!-- Producto más / menos vendido -->
            <Grid ColumnDefinitions="*,16,*">
                <Border Grid.Column="0" CornerRadius="14" Padding="20,18"
                        BorderBrush="#3834E0A1" BorderThickness="1" Background="#1834E0A1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#2834E0A1">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Path Classes="svg" Stroke="#5CE8B4" Data="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
                                        <Path Classes="svg" Stroke="#5CE8B4" Data="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
                                        <Path Classes="svg" Stroke="#5CE8B4" Data="M4 22h16"/>
                                        <Path Classes="svg" Stroke="#5CE8B4" Data="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
                                        <Path Classes="svg" Stroke="#5CE8B4" Data="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
                                        <Path Classes="svg" Stroke="#5CE8B4" Data="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="PRODUCTO MÁS VENDIDO" Classes="eyebrow" Foreground="#5CE8B4"/>
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding ProductoMasVendido}" FontSize="21" FontWeight="Bold" Foreground="#EEF2F6" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ProductoMasVendidoSub}" FontSize="13" Foreground="#8B96A4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="14" Padding="20,18"
                        BorderBrush="#33FF8B8B" BorderThickness="1" Background="#14FF6B6B">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#24FF6B6B">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Polyline Classes="svg" Stroke="#FF8B8B" Points="23,18 13.5,8.5 8.5,13.5 1,6"/>
                                        <Polyline Classes="svg" Stroke="#FF8B8B" Points="17,18 23,18 23,12"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="PRODUCTO MENOS VENDIDO" Classes="eyebrow" Foreground="#FF8B8B"/>
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding ProductoMenosVendido}" FontSize="21" FontWeight="Bold" Foreground="#EEF2F6" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ProductoMenosVendidoSub}" FontSize="13" Foreground="#8B96A4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- KPIs -->
            <Grid ColumnDefinitions="*,*,*,*">
                <Grid.Styles>
                    <Style Selector="Border.kpi">
                        <Setter Property="Background" Value="#0AFFFFFF"/>
                        <Setter Property="BorderBrush" Value="#12FFFFFF"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="14"/>
                        <Setter Property="Padding" Value="18,15"/>
                        <Setter Property="Margin" Value="0,0,14,0"/>
                    </Style>
                    <Style Selector="TextBlock.kpival">
                        <Setter Property="FontSize" Value="24"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#EEF2F6"/>
                    </Style>
                </Grid.Styles>

                <Border Grid.Column="0" Classes="kpi">
                    <StackPanel Spacing="8">
                        <TextBlock Text="VENTAS TOTALES" Classes="eyebrow"/>
                        <TextBlock Text="{Binding KVentas}" Classes="kpival" Foreground="#5CE8B4"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="kpi">
                    <StackPanel Spacing="8">
                        <TextBlock Text="DESPACHOS" Classes="eyebrow"/>
                        <TextBlock Text="{Binding KDespachos}" Classes="kpival"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="kpi">
                    <StackPanel Spacing="8">
                        <TextBlock Text="TICKET PROMEDIO" Classes="eyebrow"/>
                        <TextBlock Text="{Binding KTicket}" Classes="kpival"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="kpi" Margin="0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="UNIDADES VENDIDAS" Classes="eyebrow"/>
                        <TextBlock Text="{Binding KUnidades}" Classes="kpival"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Filtros -->
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="FILTRAR DESPACHOS" Classes="eyebrow" VerticalAlignment="Center"/>
                <TextBlock Text="desde" FontSize="12.5" Foreground="#8B96A4" VerticalAlignment="Center"/>
                <CalendarDatePicker SelectedDate="{Binding FechaInicio}" Width="150"/>
                <TextBlock Text="hasta" FontSize="12.5" Foreground="#8B96A4" VerticalAlignment="Center"/>
                <CalendarDatePicker SelectedDate="{Binding FechaFin}" Width="150"/>
                <Button Content="Generar reporte"
                        Command="{Binding GenerarReporteCommand}"
                        Background="#34E0A1" Foreground="#04160E"
                        FontWeight="SemiBold" CornerRadius="10" Padding="16,9"/>
            </StackPanel>

            <!-- Tabla + gráfico -->
            <Grid ColumnDefinitions="1.5*,16,*" Height="330">

                <!-- Tabla de despachos -->
                <Border Grid.Column="0" CornerRadius="14" BorderBrush="#12FFFFFF" BorderThickness="1"
                        Background="#04FFFFFF" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="130,*,90,120" Background="#08FFFFFF" >
                            <TextBlock Grid.Column="0" Text="No. DESPACHO" Classes="eyebrow" Margin="20,13"/>
                            <TextBlock Grid.Column="1" Text="FECHA Y HORA" Classes="eyebrow" Margin="0,13"/>
                            <TextBlock Grid.Column="2" Text="ÍTEMS" Classes="eyebrow" Margin="0,13" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="TOTAL VENTA" Classes="eyebrow" Margin="0,13,20,13" HorizontalAlignment="Right"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding DespachosRango}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DespachoReporteItem">
                                            <Border BorderBrush="#0CFFFFFF" BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="130,*,90,120" Height="46">
                                                    <TextBlock Grid.Column="0" Text="{Binding IdTexto}" Margin="20,0"
                                                               FontFamily="Consolas, monospace" FontSize="12.5" Foreground="#5CE8B4" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FechaTexto}" FontSize="13" Foreground="#C2CCD6" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Unidades}" HorizontalAlignment="Center"
                                                               FontFamily="Consolas, monospace" FontSize="13" Foreground="#8B96A4" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding TotalTexto}" Margin="0,0,20,0" HorizontalAlignment="Right"
                                                               FontFamily="Consolas, monospace" FontSize="13.5" FontWeight="SemiBold" Foreground="#EEF2F6" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Sin despachos en el periodo seleccionado."
                                           IsVisible="{Binding SinDespachos}"
                                           Foreground="#8B96A4" FontSize="14"
                                           HorizontalAlignment="Center" Margin="0,40"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Gráfico ventas por día -->
                <Border Grid.Column="2" CornerRadius="14" BorderBrush="#12FFFFFF" BorderThickness="1"
                        Background="#04FFFFFF" Padding="20,18">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="VENTAS POR DÍA" Classes="eyebrow" Margin="0,0,0,16"/>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Barras}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BarraDia">
                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="8" Margin="4,0">
                                        <TextBlock Text="{Binding ValorTexto}" FontFamily="Consolas, monospace"
                                                   FontSize="9" Foreground="#8B96A4" HorizontalAlignment="Center"/>
                                        <Border Width="24" Height="{Binding Altura}"
                                                Background="{Binding Color}" CornerRadius="6,6,3,3"/>
                                        <TextBlock Text="{Binding Etiqueta}" FontFamily="Consolas, monospace"
                                                   FontSize="9" Foreground="#6B7684" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- Total del periodo -->
            <Border CornerRadius="14" BorderBrush="#3034E0A1" BorderThickness="1" Background="#0D34E0A1" Padding="22,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL EN EL PERIODO SELECCIONADO" Classes="eyebrow" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding KVentas}" FontSize="28" FontWeight="Bold" Foreground="#5CE8B4" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
