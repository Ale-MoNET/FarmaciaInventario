<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FarmaGestion.ViewModels"
             xmlns:conv="clr-namespace:FarmaGestion.Views.Converters"
             x:Class="FarmaGestion.Views.ReportesView"
             x:DataType="vm:ReportesViewModel"
             Background="#0A0D13">

    <UserControl.Resources>
        <conv:RoleFilterBgConverter x:Key="FiltroBg"/>
        <conv:RoleFilterFgConverter x:Key="FiltroFg"/>
        <conv:EstadoLoteColorConverter x:Key="EstadoLoteColor"/>
        <conv:AnuladoOpacidadConverter x:Key="AnuladoOpacidad"/>
        <conv:AnuladoTachadoConverter x:Key="AnuladoTachado"/>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.chip">
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="#08FFFFFF"/>
            <Setter Property="Foreground" Value="#C2CCD6"/>
            <Setter Property="BorderBrush" Value="#1FFFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontFamily" Value="Consolas, 'Courier New', monospace"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#8B96A4"/>
        </Style>
        <Style Selector="Path.svg">
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeLineCap" Value="Round"/>
            <Setter Property="StrokeJoin" Value="Round"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
        <Style Selector="Polyline.svg">
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Fill" Value="Transparent"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="#0A0D13">
        <StackPanel Margin="22" Spacing="16">


            <!-- Vencimientos de lotes -->
            <Border CornerRadius="14" BorderBrush="#12FFFFFF" BorderThickness="1" Background="#04FFFFFF" Padding="20,18">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="3">
                            <TextBlock Text="VENCIMIENTOS DE LOTES" Classes="eyebrow"/>
                            <TextBlock Text="Lotes con existencias según su fecha de vencimiento. Da de baja los vencidos desde aquí."
                                       FontSize="12.5" Foreground="#8B96A4" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="ghost" Content="Actualizar" VerticalAlignment="Top"
                                Command="{Binding CargarVencimientosCommand}"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="chip" Command="{Binding SeleccionarHorizonteCommand}" CommandParameter="0"
                                Background="{Binding Horizonte, Converter={StaticResource FiltroBg}, ConverterParameter=0}"
                                Foreground="{Binding Horizonte, Converter={StaticResource FiltroFg}, ConverterParameter=0}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="Vencidos"/><TextBlock Text="{Binding CVencidos}" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="chip" Command="{Binding SeleccionarHorizonteCommand}" CommandParameter="30"
                                Background="{Binding Horizonte, Converter={StaticResource FiltroBg}, ConverterParameter=30}"
                                Foreground="{Binding Horizonte, Converter={StaticResource FiltroFg}, ConverterParameter=30}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="30 días"/><TextBlock Text="{Binding C30}" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="chip" Command="{Binding SeleccionarHorizonteCommand}" CommandParameter="60"
                                Background="{Binding Horizonte, Converter={StaticResource FiltroBg}, ConverterParameter=60}"
                                Foreground="{Binding Horizonte, Converter={StaticResource FiltroFg}, ConverterParameter=60}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="60 días"/><TextBlock Text="{Binding C60}" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="chip" Command="{Binding SeleccionarHorizonteCommand}" CommandParameter="90"
                                Background="{Binding Horizonte, Converter={StaticResource FiltroBg}, ConverterParameter=90}"
                                Foreground="{Binding Horizonte, Converter={StaticResource FiltroFg}, ConverterParameter=90}">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <TextBlock Text="90 días"/><TextBlock Text="{Binding C90}" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Classes="chip" Content="Todos" Command="{Binding SeleccionarHorizonteCommand}" CommandParameter="-1"
                                Background="{Binding Horizonte, Converter={StaticResource FiltroBg}, ConverterParameter=-1}"
                                Foreground="{Binding Horizonte, Converter={StaticResource FiltroFg}, ConverterParameter=-1}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding TituloLotes}" FontSize="12.5" Foreground="#C2CCD6"/>

                    <Border CornerRadius="12" BorderBrush="#12FFFFFF" BorderThickness="1" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,120,120,110,110,90,150,110" Background="#08FFFFFF">
                                <TextBlock Grid.Column="0" Text="PRODUCTO" Classes="eyebrow" Margin="16,11"/>
                                <TextBlock Grid.Column="1" Text="CÓDIGO" Classes="eyebrow" Margin="0,11"/>
                                <TextBlock Grid.Column="2" Text="LOTE" Classes="eyebrow" Margin="0,11"/>
                                <TextBlock Grid.Column="3" Text="VENCE" Classes="eyebrow" Margin="0,11"/>
                                <TextBlock Grid.Column="4" Text="DÍAS" Classes="eyebrow" Margin="0,11"/>
                                <TextBlock Grid.Column="5" Text="EXISTENCIA" Classes="eyebrow" Margin="0,11"/>
                                <TextBlock Grid.Column="6" Text="ESTADO" Classes="eyebrow" Margin="0,11"/>
                                <TextBlock Grid.Column="7" Text="" Classes="eyebrow"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding LotesVencimiento}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:LoteVencimientoItem">
                                                <Border BorderBrush="#0CFFFFFF" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="*,120,120,110,110,90,150,110" Height="44">
                                                        <TextBlock Grid.Column="0" Text="{Binding Producto}" Margin="16,0" FontSize="13"
                                                                   Foreground="#EEF2F6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Codigo}" FontFamily="Consolas, monospace" FontSize="12"
                                                                   Foreground="#8B96A4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding NumeroLote}" FontFamily="Consolas, monospace" FontSize="12.5"
                                                                   Foreground="#C2CCD6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding VenceTexto}" FontSize="12.5"
                                                                   Foreground="#C2CCD6" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding DiasTexto}" FontSize="12.5"
                                                                   Foreground="#8B96A4" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding Existencias, StringFormat='{}{0} u'}" FontFamily="Consolas, monospace"
                                                                   FontSize="12.5" Foreground="#EEF2F6" VerticalAlignment="Center"/>
                                                        <Border Grid.Column="6" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="999" Padding="10,3"
                                                                Background="{Binding Estado, Converter={StaticResource EstadoLoteColor}}">
                                                            <TextBlock Text="{Binding EstadoTexto}" FontSize="11" FontWeight="SemiBold"
                                                                       Foreground="{Binding Estado, Converter={StaticResource EstadoLoteColor}, ConverterParameter=fg}"/>
                                                        </Border>
                                                        <Button Grid.Column="7" Content="Dar de baja" Click="BtnBajaLote_Click"
                                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                FontSize="11.5" Padding="10,4" CornerRadius="8"
                                                                Background="#08FFFFFF" Foreground="#FF8B8B"
                                                                BorderBrush="#2EFF6B6B" BorderThickness="1"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No hay lotes en este rango." IsVisible="{Binding SinLotes}"
                                               Foreground="#8B96A4" FontSize="13.5" HorizontalAlignment="Center" Margin="0,28"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <TextBlock Text="ÚLTIMAS BAJAS" Classes="eyebrow" Margin="0,8,0,0"/>
                    <Border CornerRadius="12" BorderBrush="#12FFFFFF" BorderThickness="1" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="150,*,120,80,1.2*,120" Background="#08FFFFFF">
                                <TextBlock Grid.Column="0" Text="FECHA" Classes="eyebrow" Margin="16,11"/>
                                <TextBlock Grid.Column="1" Text="PRODUCTO" Classes="eyebrow" Margin="0,11"/>
                                <TextBlock Grid.Column="2" Text="LOTE" Classes="eyebrow" Margin="0,11"/>
                                <TextBlock Grid.Column="3" Text="CANT." Classes="eyebrow" Margin="0,11"/>
                                <TextBlock Grid.Column="4" Text="MOTIVO" Classes="eyebrow" Margin="0,11"/>
                                <TextBlock Grid.Column="5" Text="USUARIO" Classes="eyebrow" Margin="0,11"/>
                            </Grid>
                            <ScrollViewer Grid.Row="1" MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding BajasRecientes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BajaItem">
                                                <Border BorderBrush="#0CFFFFFF" BorderThickness="0,0,0,1">
                                                    <Grid ColumnDefinitions="150,*,120,80,1.2*,120" Height="40">
                                                        <TextBlock Grid.Column="0" Text="{Binding FechaTexto}" Margin="16,0" FontSize="12.5"
                                                                   Foreground="#C2CCD6" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Producto}" FontSize="13"
                                                                   Foreground="#EEF2F6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding NumeroLote}" FontFamily="Consolas, monospace" FontSize="12.5"
                                                                   Foreground="#C2CCD6" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding Cantidad, StringFormat='{}{0} u'}" FontFamily="Consolas, monospace"
                                                                   FontSize="12.5" Foreground="#FF8B8B" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding Motivo}" FontSize="12.5"
                                                                   Foreground="#C2CCD6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding Usuario}" FontSize="12.5"
                                                                   Foreground="#8B96A4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Todavía no se ha registrado ninguna baja." IsVisible="{Binding SinBajas}"
                                               Foreground="#8B96A4" FontSize="13" HorizontalAlignment="Center" Margin="0,22"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Producto más / menos vendido -->
            <Grid ColumnDefinitions="*,16,*">
                <Border Grid.Column="0" CornerRadius="14" Padding="20,18"
                        BorderBrush="#3834E0A1" BorderThickness="1" Background="#1834E0A1">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#2834E0A1">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Path Classes="svg" Stroke="#5CE8B4" Data="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
                                        <Path Classes="svg" Stroke="#5CE8B4" Data="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
                                        <Path Classes="svg" Stroke="#5CE8B4" Data="M4 22h16"/>
                                        <Path Classes="svg" Stroke="#5CE8B4" Data="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
                                        <Path Classes="svg" Stroke="#5CE8B4" Data="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
                                        <Path Classes="svg" Stroke="#5CE8B4" Data="M18 2H6v7a6 6 0 0 0 12 0V2Z"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="PRODUCTO MÁS VENDIDO" Classes="eyebrow" Foreground="#5CE8B4"/>
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding ProductoMasVendido}" FontSize="21" FontWeight="Bold" Foreground="#EEF2F6" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ProductoMasVendidoSub}" FontSize="13" Foreground="#8B96A4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="14" Padding="20,18"
                        BorderBrush="#33FF8B8B" BorderThickness="1" Background="#14FF6B6B">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="7" Background="#24FF6B6B">
                                <Viewbox Width="15" Height="15">
                                    <Canvas Width="24" Height="24">
                                        <Polyline Classes="svg" Stroke="#FF8B8B" Points="23,18 13.5,8.5 8.5,13.5 1,6"/>
                                        <Polyline Classes="svg" Stroke="#FF8B8B" Points="17,18 23,18 23,12"/>
                                    </Canvas>
                                </Viewbox>
                            </Border>
                            <TextBlock Text="PRODUCTO MENOS VENDIDO" Classes="eyebrow" Foreground="#FF8B8B"/>
                        </StackPanel>
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding ProductoMenosVendido}" FontSize="21" FontWeight="Bold" Foreground="#EEF2F6" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ProductoMenosVendidoSub}" FontSize="13" Foreground="#8B96A4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- KPIs -->
            <Grid ColumnDefinitions="*,*,*,*">
                <Grid.Styles>
                    <Style Selector="Border.kpi">
                        <Setter Property="Background" Value="#0AFFFFFF"/>
                        <Setter Property="BorderBrush" Value="#12FFFFFF"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="14"/>
                        <Setter Property="Padding" Value="18,15"/>
                        <Setter Property="Margin" Value="0,0,14,0"/>
                    </Style>
                    <Style Selector="TextBlock.kpival">
                        <Setter Property="FontSize" Value="24"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#EEF2F6"/>
                    </Style>
                </Grid.Styles>

                <Border Grid.Column="0" Classes="kpi">
                    <StackPanel Spacing="8">
                        <TextBlock Text="VENTAS TOTALES" Classes="eyebrow"/>
                        <TextBlock Text="{Binding KVentas}" Classes="kpival" Foreground="#5CE8B4"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="kpi">
                    <StackPanel Spacing="8">
                        <TextBlock Text="DESPACHOS" Classes="eyebrow"/>
                        <TextBlock Text="{Binding KDespachos}" Classes="kpival"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="kpi">
                    <StackPanel Spacing="8">
                        <TextBlock Text="TICKET PROMEDIO" Classes="eyebrow"/>
                        <TextBlock Text="{Binding KTicket}" Classes="kpival"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Classes="kpi" Margin="0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="UNIDADES VENDIDAS" Classes="eyebrow"/>
                        <TextBlock Text="{Binding KUnidades}" Classes="kpival"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Filtros -->
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                <TextBlock Text="FILTRAR DESPACHOS" Classes="eyebrow" VerticalAlignment="Center"/>
                <TextBlock Text="desde" FontSize="12.5" Foreground="#8B96A4" VerticalAlignment="Center"/>
                <CalendarDatePicker SelectedDate="{Binding FechaInicio}" Width="150"/>
                <TextBlock Text="hasta" FontSize="12.5" Foreground="#8B96A4" VerticalAlignment="Center"/>
                <CalendarDatePicker SelectedDate="{Binding FechaFin}" Width="150"/>
                <Button Content="Generar reporte"
                        Command="{Binding GenerarReporteCommand}"
                        Background="#34E0A1" Foreground="#04160E"
                        FontWeight="SemiBold" CornerRadius="10" Padding="16,9"/>
            </StackPanel>

            <!-- Tabla + gráfico -->
            <Grid ColumnDefinitions="1.5*,16,*" Height="330">

                <!-- Tabla de despachos -->
                <Border Grid.Column="0" CornerRadius="14" BorderBrush="#12FFFFFF" BorderThickness="1"
                        Background="#04FFFFFF" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <Grid Grid.Row="0" ColumnDefinitions="124,*,64,110,100" Background="#08FFFFFF" >
                            <TextBlock Grid.Column="0" Text="No. DESPACHO" Classes="eyebrow" Margin="20,13"/>
                            <TextBlock Grid.Column="1" Text="FECHA Y HORA" Classes="eyebrow" Margin="0,13"/>
                            <TextBlock Grid.Column="2" Text="ÍTEMS" Classes="eyebrow" Margin="0,13" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="TOTAL VENTA" Classes="eyebrow" Margin="0,13,12,13" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="" Classes="eyebrow"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding DespachosRango}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DespachoReporteItem">
                                            <Border BorderBrush="#0CFFFFFF" BorderThickness="0,0,0,1"
                                                    Opacity="{Binding Anulado, Converter={StaticResource AnuladoOpacidad}}">
                                                <Grid ColumnDefinitions="124,*,64,110,100" Height="46">
                                                    <TextBlock Grid.Column="0" Text="{Binding IdTexto}" Margin="20,0"
                                                               FontFamily="Consolas, monospace" FontSize="12.5" Foreground="#5CE8B4" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding FechaTexto}" FontSize="13" Foreground="#C2CCD6" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Unidades}" HorizontalAlignment="Center"
                                                               FontFamily="Consolas, monospace" FontSize="13" Foreground="#8B96A4" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding TotalTexto}" Margin="0,0,12,0" HorizontalAlignment="Right"
                                                               FontFamily="Consolas, monospace" FontSize="13.5" FontWeight="SemiBold" Foreground="#EEF2F6" VerticalAlignment="Center"
                                                               TextDecorations="{Binding Anulado, Converter={StaticResource AnuladoTachado}}"/>
                                                    <Button Grid.Column="4" Content="Deshacer" Click="BtnDeshacerDespacho_Click"
                                                            IsVisible="{Binding PuedeDeshacer}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            FontSize="11.5" Padding="10,4" CornerRadius="8"
                                                            Background="#08FFFFFF" Foreground="#FF8B8B"
                                                            BorderBrush="#2EFF6B6B" BorderThickness="1"/>
                                                    <Border Grid.Column="4" IsVisible="{Binding Anulado}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            CornerRadius="999" Padding="10,3" Background="#24FF6B6B">
                                                        <TextBlock Text="Anulado" FontSize="11" FontWeight="SemiBold" Foreground="#FF8B8B"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Sin despachos en el periodo seleccionado."
                                           IsVisible="{Binding SinDespachos}"
                                           Foreground="#8B96A4" FontSize="14"
                                           HorizontalAlignment="Center" Margin="0,40"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Gráfico ventas por día -->
                <Border Grid.Column="2" CornerRadius="14" BorderBrush="#12FFFFFF" BorderThickness="1"
                        Background="#04FFFFFF" Padding="20,18">
                    <Grid RowDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Text="VENTAS POR DÍA" Classes="eyebrow" Margin="0,0,0,16"/>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Barras}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BarraDia">
                                    <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="8" Margin="4,0">
                                        <TextBlock Text="{Binding ValorTexto}" FontFamily="Consolas, monospace"
                                                   FontSize="9" Foreground="#8B96A4" HorizontalAlignment="Center"/>
                                        <Border Width="24" Height="{Binding Altura}"
                                                Background="{Binding Color}" CornerRadius="6,6,3,3"/>
                                        <TextBlock Text="{Binding Etiqueta}" FontFamily="Consolas, monospace"
                                                   FontSize="9" Foreground="#6B7684" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <!-- Total del periodo -->
            <Border CornerRadius="14" BorderBrush="#3034E0A1" BorderThickness="1" Background="#0D34E0A1" Padding="22,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="TOTAL EN EL PERIODO SELECCIONADO" Classes="eyebrow" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding KVentas}" FontSize="28" FontWeight="Bold" Foreground="#5CE8B4" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
