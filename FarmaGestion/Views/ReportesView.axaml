<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:FarmaGestion.ViewModels"
             x:Class="FarmaGestion.Views.ReportesView"
             x:DataType="vm:ReportesViewModel">
    
    <Grid RowDefinitions="Auto, Auto, *" Margin="20">
        
        <!-- SECCIÓN 1: Tarjetas de Resumen (Más vendido / Menos vendido) -->
        <Grid Grid.Row="0" ColumnDefinitions="*, *" Margin="0,0,0,20">
            <!-- Tarjeta 1: Fondo oscuro adaptado a Dark Mode -->
            <Border Grid.Column="0" Background="#1e1e1e" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="🏆 Producto Más Vendido" FontSize="16" FontWeight="SemiBold" Foreground="#4caf50"/>
                    <TextBlock Text="{Binding ProductoMasVendido}" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            
            <!-- Tarjeta 2: Fondo oscuro adaptado a Dark Mode -->
            <Border Grid.Column="1" Background="#1e1e1e" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="15" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="📉 Producto Menos Vendido" FontSize="16" FontWeight="SemiBold" Foreground="#e53935"/>
                    <TextBlock Text="{Binding ProductoMenosVendido}" FontSize="20" FontWeight="Bold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- SECCIÓN 2: Filtros de Fecha para Despachos -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="15" Margin="0,0,0,15" VerticalAlignment="Center">
            <TextBlock Text="Filtrar despachos desde:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <CalendarDatePicker SelectedDate="{Binding FechaInicio}" Width="150"/>
            
            <TextBlock Text="hasta:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <CalendarDatePicker SelectedDate="{Binding FechaFin}" Width="150"/>
            
            <Button Content="Generar Reporte" 
                    Command="{Binding GenerarReporteCommand}"
                    Background="#007bff" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <!-- SECCIÓN 3: Tabla de Resultados -->
        <Grid Grid.Row="2" RowDefinitions="*, Auto">
            <DataGrid Grid.Row="0" 
                      ItemsSource="{Binding DespachosRango}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      GridLinesVisibility="All"
                      BorderThickness="1" BorderBrush="LightGray">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="No. Despacho" Binding="{Binding Id}" Width="120"/>
                    <DataGridTextColumn Header="Fecha y Hora" Binding="{Binding Fecha, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Width="200"/>
                    <DataGridTextColumn Header="Total Venta" Binding="{Binding Total, StringFormat='{}{0:C}'}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <!-- Totalizador del rango -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <TextBlock Text="Total en el periodo seleccionado:" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding TotalVentasRango, StringFormat='{}{0:C}'}" FontSize="22" FontWeight="Bold" Foreground="#007bff"/>
            </StackPanel>
        </Grid>
        
    </Grid>
</UserControl>