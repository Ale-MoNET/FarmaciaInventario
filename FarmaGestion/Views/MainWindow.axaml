<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FarmaGestion.Views"
        x:Class="FarmaGestion.Views.MainWindow"
        Title="Gestión de Inventario y Despacho - Farmacia"
        Icon="/Assets/farma-icon.png"
        Width="1180" Height="820" WindowStartupLocation="CenterScreen"
        Background="#05070A">

    <Window.Styles>
        <!-- Pestañas oscuras con subrayado verde en la activa -->
        <Style Selector="TabControl">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="#8B96A4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="#EEF2F6"/>
        </Style>
        <!-- Ocultamos el subrayado por defecto del tema (queda pegado al texto). -->
        <Style Selector="TabItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="#0AFFFFFF"/>
        </Style>

        <!-- Subrayado propio: separado del texto y solo visible en la pestaña activa. -->
        <Style Selector="Border.tabunderline">
            <Setter Property="Height" Value="2.5"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,12,0,0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="TabItem:selected Border.tabunderline">
            <Setter Property="Background" Value="#34E0A1"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- BARRA SUPERIOR: marca, usuario y cerrar sesión -->
        <Border Grid.Row="0" Background="#0A0D13" Padding="22,14"
                BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                <!-- Logo + marca -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="#34E0A1"
                            BoxShadow="0 4 14 0 #5934E0A1">
                        <TextBlock Text="+" FontSize="24" FontWeight="Bold" Foreground="#04160E"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="FarmaGestión" FontSize="16" FontWeight="Bold" Foreground="#EEF2F6"/>
                        <TextBlock Text="SISTEMA DE INVENTARIO"
                                   FontFamily="Consolas, 'Courier New', monospace"
                                   FontSize="9" Foreground="#8B96A4"/>
                    </StackPanel>
                </StackPanel>

                <!-- Chip de usuario -->
                <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0"
                        CornerRadius="999" Background="#0DFFFFFF" BorderBrush="#17FFFFFF" BorderThickness="1"
                        Padding="6,6,14,6">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="26" Height="26" CornerRadius="13" Background="#34E0A1">
                            <TextBlock x:Name="TxtAvatar" Text="A" FontSize="12" FontWeight="Bold"
                                       Foreground="#04160E"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="TxtUsuarioNombre" Text="usuario"
                                       FontSize="12.5" FontWeight="SemiBold" Foreground="#EEF2F6"/>
                            <TextBlock x:Name="TxtUsuarioRol" Text="ROL"
                                       FontFamily="Consolas, 'Courier New', monospace"
                                       FontSize="9" Foreground="#8B96A4"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Cerrar sesión -->
                <Button Grid.Column="3"
                        Click="BtnCerrarSesion_Click"
                        VerticalAlignment="Center"
                        Background="#08FFFFFF" Foreground="#C2CCD6"
                        BorderBrush="#1AFFFFFF" BorderThickness="1"
                        FontWeight="SemiBold" Padding="14,9" CornerRadius="10">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Viewbox Width="15" Height="15">
                            <Canvas Width="24" Height="24">
                                <Path Stroke="#C2CCD6" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                      Data="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                                <Path Stroke="#C2CCD6" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round" Fill="Transparent"
                                      Data="M16 17 21 12 16 7"/>
                                <Line Stroke="#C2CCD6" StrokeThickness="2" StrokeLineCap="Round" StartPoint="21,12" EndPoint="9,12"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Cerrar sesión" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- PESTAÑAS -->
        <TabControl Grid.Row="1" Margin="0" Padding="0" Background="#05070A">
            <TabControl.Styles>
                <!-- Íconos vectoriales (lucide) que heredan el color de la pestaña -->
                <Style Selector="Path.tabicon">
                    <Setter Property="Stroke" Value="{Binding $parent[TabItem].Foreground}"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                    <Setter Property="StrokeLineCap" Value="Round"/>
                    <Setter Property="StrokeJoin" Value="Round"/>
                    <Setter Property="Fill" Value="Transparent"/>
                </Style>
                <Style Selector="Ellipse.tabicon">
                    <Setter Property="Stroke" Value="{Binding $parent[TabItem].Foreground}"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                    <Setter Property="Fill" Value="Transparent"/>
                </Style>
                <Style Selector="Line.tabicon">
                    <Setter Property="Stroke" Value="{Binding $parent[TabItem].Foreground}"/>
                    <Setter Property="StrokeThickness" Value="2"/>
                    <Setter Property="StrokeLineCap" Value="Round"/>
                </Style>
            </TabControl.Styles>

            <!-- Inventario (caja) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="tabicon" Data="M21 8V17a2 2 0 0 1-1 1.73l-7 4a2 2 0 0 1-2 0l-7-4A2 2 0 0 1 3 17V8"/>
                                    <Path Classes="tabicon" Data="M3.29 7 12 12l8.71-5"/>
                                    <Path Classes="tabicon" Data="M12 22V12"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Inventario" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Classes="tabunderline"/>
                    </StackPanel>
                </TabItem.Header>
                <views:InventarioView />
            </TabItem>

            <!-- Despacho (carrito) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Ellipse Classes="tabicon" Canvas.Left="8" Canvas.Top="20" Width="2" Height="2"/>
                                    <Ellipse Classes="tabicon" Canvas.Left="19" Canvas.Top="20" Width="2" Height="2"/>
                                    <Path Classes="tabicon" Data="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Despacho" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Classes="tabunderline"/>
                    </StackPanel>
                </TabItem.Header>
                <views:DespachoView />
            </TabItem>

            <!-- Reportes (barras) -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Line Classes="tabicon" StartPoint="18,20" EndPoint="18,10"/>
                                    <Line Classes="tabicon" StartPoint="12,20" EndPoint="12,4"/>
                                    <Line Classes="tabicon" StartPoint="6,20" EndPoint="6,14"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Reportes" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Classes="tabunderline"/>
                    </StackPanel>
                </TabItem.Header>
                <views:ReportesView />
            </TabItem>

            <!-- Usuarios (personas) -->
            <TabItem x:Name="TabUsuarios">
                <TabItem.Header>
                    <StackPanel Spacing="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path Classes="tabicon" Data="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                                    <Ellipse Classes="tabicon" Canvas.Left="5" Canvas.Top="3" Width="8" Height="8"/>
                                    <Path Classes="tabicon" Data="M23 21v-2a4 4 0 0 0-3-3.87"/>
                                    <Path Classes="tabicon" Data="M16 3.13a4 4 0 0 1 0 7.75"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Usuarios" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border Classes="tabunderline"/>
                    </StackPanel>
                </TabItem.Header>
                <views:UsuariosView />
            </TabItem>
        </TabControl>

    </Grid>
</Window>
