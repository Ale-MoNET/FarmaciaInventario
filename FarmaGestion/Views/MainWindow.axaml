<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:FarmaGestion.Views" x:Class="FarmaGestion.Views.MainWindow" Title="Gestión de Inventario y Despacho - Farmacia" Width="1024" Height="768" WindowStartupLocation="CenterScreen">

    <TabControl Margin="10">
        <!-- Pestaña 1: Módulo de Inventario -->
        <TabItem Header="📦 Inventario" FontSize="16" FontWeight="SemiBold">
            <!-- Aquí inyectamos el UserControl que acabamos de crear -->
            <views:InventarioView />
        </TabItem>
        
        <!-- Pestaña 2: Módulo de Despacho (Lo haremos después) -->
        <TabItem Header="🛒 Despacho" FontSize="16" FontWeight="SemiBold">
            <views:DespachoView />
        </TabItem>

        <!-- Pestaña 3: Módulo de Reportes (Lo haremos después) -->
        <TabItem Header="📊 Reportes" FontSize="16" FontWeight="SemiBold">
            <views:ReportesView />
        </TabItem>
    </TabControl>
</Window>