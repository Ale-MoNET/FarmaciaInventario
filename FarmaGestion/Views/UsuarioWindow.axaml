<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FarmaGestion.ViewModels"
        x:Class="FarmaGestion.Views.UsuarioWindow"
        x:DataType="vm:UsuarioFormViewModel"
        Title="{Binding TituloVentana}"
        Icon="/Assets/farma-icon.png"
        Width="460" Height="600"
        MinWidth="400" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0A0D13">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontFamily" Value="Consolas, 'Courier New', monospace"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#8B96A4"/>
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="Foreground" Value="#EEF2F6"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="CaretBrush" Value="#34E0A1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#34E0A1"/>
        </Style>
    </Window.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" Spacing="16">

            <!-- Cabecera -->
            <StackPanel Orientation="Horizontal" Spacing="13" Margin="0,0,0,6">
                <Border Width="42" Height="42" CornerRadius="12" Background="#34E0A1"
                        BoxShadow="0 4 14 0 #5934E0A1">
                    <TextBlock Text="+" FontSize="27" FontWeight="Bold" Foreground="#04160E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="GESTIÓN DE USUARIOS" Classes="label"/>
                    <TextBlock Text="{Binding TituloVentana}" FontSize="18" FontWeight="Bold" Foreground="#EEF2F6"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="7">
                <TextBlock Text="NOMBRE DE USUARIO" Classes="label"/>
                <TextBox x:Name="TxtNombreUsuario" Classes="field"
                         Text="{Binding NombreUsuario}" PlaceholderText="Ej. farmacia01"/>
            </StackPanel>

            <Grid ColumnDefinitions="*, 16, *">
                <StackPanel Grid.Column="0" Spacing="7">
                    <TextBlock Text="ROL" Classes="label"/>
                    <ComboBox ItemsSource="{Binding RolesDisponibles}"
                              SelectedItem="{Binding RolSeleccionado}"
                              FontSize="15" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Spacing="7">
                    <TextBlock Text="ESTADO" Classes="label"/>
                    <CheckBox IsChecked="{Binding Activo}" Content="Usuario activo"
                              Foreground="#EEF2F6" FontSize="14"/>
                </StackPanel>
            </Grid>

            <Border Height="1" Background="#12FFFFFF" Margin="0,2"/>

            <StackPanel Spacing="7">
                <TextBlock Text="CONTRASEÑA" Classes="label"/>
                <TextBox Classes="field" Text="{Binding Password}"
                         PasswordChar="●" PlaceholderText="Mínimo 8, con mayúscula y número"/>
            </StackPanel>

            <StackPanel Spacing="7">
                <TextBlock Text="CONFIRMAR CONTRASEÑA" Classes="label"/>
                <TextBox Classes="field" Text="{Binding ConfirmarPassword}"
                         PasswordChar="●" PlaceholderText="Repite la contraseña"/>
            </StackPanel>

            <!-- Nota para edición -->
            <TextBlock Text="💡 Deja la contraseña vacía para no cambiarla."
                       IsVisible="{Binding EsEdicion}"
                       Foreground="#8B96A4" FontSize="12" FontStyle="Italic"/>

            <!-- Mensaje de error -->
            <Border Background="#24FF6B6B" BorderBrush="#40FF6B6B" BorderThickness="1"
                    CornerRadius="10" Padding="12" IsVisible="{Binding MostrarError}">
                <TextBlock Text="{Binding MensajeError}" Foreground="#FF8B8B" TextWrapping="Wrap"/>
            </Border>

            <!-- Guardar -->
            <Button Content="Guardar usuario"
                    Command="{Binding GuardarCommand}"
                    Background="#34E0A1" Foreground="#04160E"
                    FontSize="15" FontWeight="Bold"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    CornerRadius="12" Padding="14" Margin="0,8,0,0"/>

        </StackPanel>
    </ScrollViewer>
</Window>
