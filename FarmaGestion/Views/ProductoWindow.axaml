<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FarmaGestion.ViewModels"
        x:Class="FarmaGestion.Views.ProductoWindow"
        x:DataType="vm:ProductoViewModel"
        Title="Registrar Nuevo Medicamento"
        Icon="/Assets/farma-icon.png"
        Width="460" SizeToContent="Height" MaxHeight="780"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="#0A0D13">

    <Window.Styles>
        <Style Selector="TextBlock.label">
            <Setter Property="FontFamily" Value="Consolas, 'Courier New', monospace"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#8B96A4"/>
        </Style>
        <Style Selector="TextBox.field">
            <Setter Property="Background" Value="#0CFFFFFF"/>
            <Setter Property="Foreground" Value="#EEF2F6"/>
            <Setter Property="BorderBrush" Value="#1AFFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="CaretBrush" Value="#34E0A1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
        <Style Selector="TextBox.field:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#34E0A1"/>
        </Style>
    </Window.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28" Spacing="16">

            <!-- Cabecera -->
            <StackPanel Orientation="Horizontal" Spacing="13" Margin="0,0,0,6">
                <Border Width="42" Height="42" CornerRadius="12" Background="#34E0A1"
                        BoxShadow="0 4 14 0 #5934E0A1">
                    <TextBlock Text="+" FontSize="27" FontWeight="Bold" Foreground="#04160E"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="GESTIÓN DE INVENTARIO" Classes="label"/>
                    <TextBlock Text="{Binding TituloVentana}" FontSize="18" FontWeight="Bold" Foreground="#EEF2F6"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Spacing="7">
                <TextBlock Text="CÓDIGO DE BARRAS" Classes="label"/>
                <TextBox x:Name="TxtCodigoBarras" Classes="field" Text="{Binding CodigoBarras}"
                         PlaceholderText="Escanea o escribe el código"/>
            </StackPanel>

            <StackPanel Spacing="7">
                <TextBlock Text="NOMBRE DEL MEDICAMENTO Y MILIGRAMOS" Classes="label"/>
                <TextBox Classes="field" Text="{Binding Nombre}" PlaceholderText="Ej. Paracetamol 500mg"/>
            </StackPanel>

            <StackPanel Spacing="7">
                <TextBlock Text="PRECIO UNITARIO (Q)" Classes="label"/>
                <TextBox Classes="field" Text="{Binding Precio}"/>
            </StackPanel>

            <!-- Primer lote: solo al crear. Después las existencias entran por "Ingresar mercadería". -->
            <Border IsVisible="{Binding MostrarPrimerLote}" Background="#07FFFFFF" BorderBrush="#12FFFFFF"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2">
                        <TextBlock Text="EXISTENCIAS INICIALES (PRIMER LOTE)" Classes="label"/>
                        <TextBlock Text="Opcional: deja todo vacío para crear el producto sin existencias."
                                   FontSize="11.5" Foreground="#8B96A4" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="*, 16, *">
                        <StackPanel Grid.Column="0" Spacing="7">
                            <TextBlock Text="LOTE" Classes="label"/>
                            <TextBox Classes="field" Text="{Binding Lote}" PlaceholderText="Ej. L-1042"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="7">
                            <TextBlock Text="CANTIDAD" Classes="label"/>
                            <TextBox Classes="field" Text="{Binding Existencias}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="7">
                        <TextBlock Text="FECHA DE VENCIMIENTO" Classes="label"/>
                        <CalendarDatePicker SelectedDate="{Binding FechaVencimiento}"
                                            HorizontalAlignment="Stretch" FontSize="15"
                                            PlaceholderText="dd/mm/aaaa"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border IsVisible="{Binding EsEdicion}" Background="#07FFFFFF" BorderBrush="#12FFFFFF"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <TextBlock FontSize="12" Foreground="#8B96A4" TextWrapping="Wrap"
                           Text="Las existencias se manejan por lote desde Inventario: «Ingresar mercadería» para sumar unidades y «Dar de baja» para retirar un lote."/>
            </Border>

            <!-- Mensaje de error de validación -->
            <Border Background="#24FF6B6B" BorderBrush="#40FF6B6B" BorderThickness="1"
                    CornerRadius="10" Padding="12" IsVisible="{Binding MostrarError}">
                <TextBlock Text="{Binding MensajeError}" Foreground="#FF8B8B" TextWrapping="Wrap"/>
            </Border>

            <!-- Guardar -->
            <Button Content="{Binding TextoBoton}"
                    Command="{Binding GuardarCommand}"
                    Background="#34E0A1" Foreground="#04160E"
                    FontSize="15" FontWeight="Bold"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    CornerRadius="12" Padding="15" Margin="0,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
