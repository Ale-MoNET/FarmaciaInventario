<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FarmaGestion.ViewModels"
        x:Class="FarmaGestion.Views.ProductoWindow"
        x:DataType="vm:ProductoViewModel"
        Title="Registrar Nuevo Medicamento"
        Width="450" Height="450"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Margin="25" Spacing="15">
        
        <TextBlock Text="Código de Barras:" FontWeight="SemiBold"/>
        <TextBox x:Name="TxtCodigoBarras" Text="{Binding CodigoBarras}" PlaceholderText="Escanea o escribe el código" FontSize="16" Padding="8"/>
        
        <TextBox Text="{Binding CodigoBarras}" Watermark="Escanea o escribe el código" FontSize="16" Padding="8"/>

        <TextBlock Text="Nombre del Medicamento:" FontWeight="SemiBold"/>
        <TextBox Text="{Binding Nombre}" Watermark="Ej. Paracetamol 500mg" FontSize="16" Padding="8"/>

        <Grid ColumnDefinitions="*, 20, *">
            <StackPanel Grid.Column="0" Spacing="10">
                <TextBlock Text="Precio Unitario (Q):" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Precio}" FontSize="16" Padding="8"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Spacing="10">
                <TextBlock Text="Existencias Iniciales:" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Existencias}" FontSize="16" Padding="8"/>
            </StackPanel>
        </Grid>

        <!-- Fíjate cómo enlazamos el Command con el método Guardar() que hicimos en el ViewModel -->
        <Button Content="Guardar Medicamento" 
                Command="{Binding GuardarCommand}" 
                Background="#28a745" Foreground="White" FontSize="16" FontWeight="Bold"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Padding="15" Margin="0,20,0,0"/>
    </StackPanel>
</Window>